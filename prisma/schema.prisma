```prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
}

model Doctor {
  id              Int              @id @default(autoincrement())
  name            String
  specialization  String
  phone           String           @unique
  consultationFee Decimal          @db.Decimal(10, 2)
  createdAt       DateTime         @default(now())
  schedules       DoctorSchedule[]
  appointments    Appointment[]

  @@index([specialization])
}

model DoctorSchedule {
  id           Int    @id @default(autoincrement())
  doctorId     Int
  dayOfWeek    Int
  startTime    String
  endTime      String
  slotDuration Int

  doctor       Doctor @relation(
    fields: [doctorId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId, dayOfWeek])
}

model Patient {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String
  dateOfBirth  DateTime?
  gender       Gender?
  createdAt    DateTime      @default(now())
  appointments Appointment[]

  @@index([name])
  @@index([phone])
}

model Appointment {
  id          Int               @id @default(autoincrement())
  patientId   Int
  doctorId    Int
  date        DateTime
  timeSlot    String
  status      AppointmentStatus @default(BOOKED)
  tokenNumber Int
  createdAt   DateTime          @default(now())

  patient     Patient           @relation(
    fields: [patientId],
    references: [id]
  )

  doctor      Doctor            @relation(
    fields: [doctorId],
    references: [id]
  )

  @@unique([doctorId, date, timeSlot])
  @@unique([date, tokenNumber])
  @@index([doctorId, date])
  @@index([patientId, date])
  @@index([date, status])
}
```
